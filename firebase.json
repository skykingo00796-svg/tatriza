{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/portal",
        "destination": "/portal.html"
      },
      {
        "source": "/orders",
        "destination": "/orders.html"
      },
      {
        "source": "/screen/about",
        "destination": "/screen/about.html"
      },
      {
        "source": "/screen/portal",
        "destination": "/screen/portal.html"
      },
      {
        "source": "/screen/orders",
        "destination": "/screen/orders.html"
      },
      {
        "source": "/verify",
        "destination": "/verify.html"
      },
      {
        "source": "/screen/verify",
        "destination": "/screen/verify.html"
      }
    ]
  }
}
