rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // يسمح للزوار بقراءة المعروضات والتصنيفات
    match /{document=**} {
      allow read: if true;
      // لا يُسمح بالإضافة أو التعديل أو الحذف إلا للمسؤول المسجل رسمياً عبر Firebase Authentication
      allow write: if request.auth != null;
    }
  }
}
