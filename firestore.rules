rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // طلبات الشراء والمهام الواردة من المتجر
    match /orders/{orderId} {
      // يسمح بإنشاء طلب شراء جديد، وقراءة تفاصيل طلب فردي بموجب رقم الطلب للتتبع والشهادة
      allow create, get: if true;
      // لا يحق سرد واستعلام قائمة الطلبات أو التعديل أو الحذف إلا للمسؤول المعتمد
      allow list, update, delete: if request.auth != null;
    }

    // عدادات الإحصائيات اليومية المجهولة (زيارات، مشاهدات القطع، إضافات السلة، نقرات الواتساب)
    // الزائر يستطيع الزيادة فقط ضمن الحقول المعتمدة، والقراءة والحذف للمسؤول فقط
    match /analytics_daily/{day} {
      allow read, delete: if request.auth != null;
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits', 'views', 'cartAdds', 'waClicks', 'devices', 'sources', 'carpets', 'updatedAt']);
    }

    // بقية المستندات (المعروضات، التصنيفات، البنرات، والإعدادات)
    // ملاحظة: الطلبات والإحصائيات مستثناة من القراءة العامة حتى لا تُسرد بيانات العملاء
    match /{col}/{document=**} {
      allow read: if !(col in ['orders', 'analytics_daily']);
      allow write: if request.auth != null;
    }
  }
}
