rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // طلبات الشراء والمهام الواردة من المتجر
    match /orders/{orderId} {
      // يسمح بإنشاء طلب شراء جديد، وقراءة تفاصيل طلب فردي بموجب رقم الطلب للتتبع والشهادة
      allow create, get: if true;
      // لا يحق سرد واستعلام قائمة الطلبات أو التعديل أو الحذف إلا للمسؤول المعتمد
      allow list, update, delete: if request.auth != null;
    }

    // بقية المستندات (المعروضات، التصنيفات، البنرات، والإعدادات)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

