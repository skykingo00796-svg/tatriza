rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // طلبات الشراء والمهام الواردة من المتجر
    match /orders/{orderId} {
      // يسمح لأي زائر بإنشاء طلب شراء جديد
      allow create: if true;
      // لا يحق القراءة أو التعديل أو الأرشفة أو الحذف إلا للمسؤول المعتمد
      allow read, update, delete: if request.auth != null;
    }

    // بقية المستندات (المعروضات، التصنيفات، البنرات، والإعدادات)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

